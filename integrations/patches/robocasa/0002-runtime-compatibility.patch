+def _normalize_ep_meta_mjcf_paths(value):
+    """
+    Rewrite serialized MJCF paths from the data collection machine to the current local repo.
+    """
+    assets_marker = "robocasa/models/assets/"
+    local_assets_root = Path(__file__).resolve().parents[1] / "models" / "assets"
+
+    if isinstance(value, dict):
+        normalized = {}
+        for k, v in value.items():
+            if k == "mjcf_path" and isinstance(v, str) and assets_marker in v:
+                rel_path = v.split(assets_marker, 1)[1]
+                normalized[k] = str(local_assets_root / rel_path)
+            else:
+                normalized[k] = _normalize_ep_meta_mjcf_paths(v)
+        return normalized
+
+    if isinstance(value, list):
+        return [_normalize_ep_meta_mjcf_paths(v) for v in value]
+
+    return value
+
