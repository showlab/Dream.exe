+    def get_elements(root, element_tag, _parent=None):
+        """
+        Backward-compatible fallback for robosuite<1.5.2.
+
+        Returns a list of (name, element) pairs for the requested tag by
+        recursively traversing the XML tree.
+        """
+        pairs = []
+        if root.tag == element_tag:
+            name = root.get("name")
+            if name is not None:
+                pairs.append((name, root))
+        for child in root:
+            pairs.extend(get_elements(child, element_tag, root))
